# Copy to `.env.local` and fill in values. Never commit `.env.local`.

# --- Reach Out — at least ONE provider (see ENVIRONMENT.md) ---
# Easiest without Clay: Hunter.io Domain Search (free tier with monthly limits)
# https://hunter.io/api-documentation#domain-search
HUNTER_API_KEY=

# Optional: Happenstance — search YOUR professional network (connections/groups) for
# people matching the company; async (~30–60s). Key from https://happenstance.ai/api/keys
# Docs: https://developer.happenstance.ai/quickstart
# HAPPENSTANCE_API_KEY=
# HAPPENSTANCE_INCLUDE_FRIENDS_CONNECTIONS=true
# HAPPENSTANCE_POLL_MS=4000
# HAPPENSTANCE_MAX_WAIT_MS=55000

# Optional: Apollo people search (many free keys cannot use mixed_people search)
# APOLLO_API_KEY=

# Optional: Clay table webhook (may require paid Clay credits)
# CLAY_WEBHOOK_URL=https://app.clay.com/webhook/YOUR_WEBHOOK_ID
# CLAY_API_KEY=

# Optional: provider order — e.g. hunter,happenstance,apollo,clay
# REACH_OUT_PROVIDERS=hunter,happenstance,apollo,clay

# Optional: max people shown on Reach Out (default 5; keeps Hunter free tier happy)
RECRUITER_MAX_RESULTS=10

# --- Auth (Google / NextAuth / Supabase email) ---
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# NEXTAUTH_URL=http://localhost:3000
# Production (required): https://www.summer2027internships.com — no trailing slash.
# Do NOT use rethinkjobs.tech or rethinkjobs.com (deprecated).
# Two Google providers: "google" (profile only) and "google-gmail" (adds gmail.readonly for Track Jobs).
# Redirect URIs in Google Cloud (same client ID for both):
#   http://localhost:3000/api/auth/callback/google
#   http://localhost:3000/api/auth/callback/google-gmail
# (Add production URLs too.)
# Canonical site URL for SEO (sitemap.xml, robots.txt, llms.txt, Open Graph, JSON-LD).
# MUST match your Google Search Console property exactly (scheme + host + www or non-www).
# Example: https://www.summer2027internships.com
# If this is missing in production, Search Console may report "URL not allowed" sitemap errors.
# MUST be https://www.summer2027internships.com (match Google Search Console exactly).
NEXT_PUBLIC_SITE_URL=https://www.summer2027internships.com
# IndexNow (Bing / Copilot / ChatGPT web search). Key file is public/{KEY}.txt
# LaunchIgniter sitemap: https://www.summer2027internships.com/sitemap.xml
# INDEXNOW_KEY=ed2244439860406b92922cfbd8bf9fbb
# Public support inbox shown on /contact-us
# NEXT_PUBLIC_SUPPORT_EMAIL=support@summer2027internships.com
# In Google Cloud → OAuth client → Authorized redirect URIs, add exactly:
#   https://www.summer2027internships.com/api/auth/callback/google
#   https://www.summer2027internships.com/api/auth/callback/google-gmail
# (Error 400 redirect_uri_mismatch = this URI or NEXTAUTH_URL does not match.)
# NEXTAUTH_SECRET=
#
# Gmail sync: enable "Gmail API" in APIs & Services → Library.
# OAuth consent screen → Scopes → add https://www.googleapis.com/auth/gmail.readonly
# If users see ACCESS_TOKEN_SCOPE_INSUFFICIENT / insufficient authentication scopes, they must
# sign out of the app and sign in with Google again so the token includes Gmail (after scopes exist).
#
# Vercel (Production): set NEXTAUTH_URL to the exact public URL (e.g. https://www.summer2027internships.com — same www/non-www as users type).
# NEXTAUTH_SECRET is required in production; without it auth routes can return HTML errors and the client shows
# "Unexpected token 'A' ... is not valid JSON" when signing in.
# Also set SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY on Production; missing keys throw when linking a Google account.

# --- Supabase ---
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# --- Internship sync (Fantastic.jobs aggregator — ATS + job board feeds) ---
# https://developer.fantastic.jobs/api/new-jobs
# Cron polls every 3 hours (vercel.json); uses time_frame=1h for incremental new jobs.
# FANTASTIC_JOBS_API_KEY=
# Email magic-link sign-in (Find Jobs, Interview Prep, etc. — no Gmail):
# NEXT_PUBLIC_SUPABASE_URL=   # same project URL as SUPABASE_URL
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# In Supabase Dashboard: Authentication → Providers → Email (enable).
# Authentication → URL Configuration → Redirect URLs (add each host/port you use):
#   http://localhost:3000/auth/callback
#   http://localhost:3001/auth/callback
#
# Branded sign-in emails (recommended — replaces default Supabase "Confirm your signup" mail):
# 1. Create a free account at https://resend.com
# 2. Verify your domain (e.g. summer2027internships.com) or use onboarding@resend.dev for testing
# 3. Add to .env.local and Vercel Production:
# RESEND_API_KEY=re_...
# AUTH_EMAIL_FROM=SuperInterns <auth@summer2027internships.com>
# Without RESEND_API_KEY, Supabase sends its default template — paste supabase/email-templates/magic-link.html
# into Supabase Dashboard → Authentication → Email Templates → Magic Link (and Confirm signup).
#
# Supabase → Authentication → URL Configuration (required for magic links):
#   Site URL: https://www.summer2027internships.com
#   Redirect URLs:
#     https://www.summer2027internships.com/auth/callback
#     http://localhost:3000/auth/callback
# If Site URL is still localhost, sign-in emails redirect to localhost after verify.
# Email magic links use server-side Supabase (SUPABASE_URL + SERVICE_ROLE_KEY only).
# Sign-in page: /login (email + Google). Gmail connect happens in-app via Connect Gmail (Track Jobs).
# Run supabase/migration_v8_auth_providers.sql for auth_provider / supabase_auth_id columns.

# --- Pro checkout (PayPal payment link) ---
# NEXT_PUBLIC_PAYPAL_PRO_URL=https://www.paypal.com/ncp/payment/6D25J3AW669TN
# NEXT_PUBLIC_PAYPAL_STARTER_URL=

# --- Optional: Gmail / OpenAI / Stripe (legacy; Pro checkout uses PayPal) ---
# OWNER_EMAILS=

# --- Admin panel (/admin) — comma-separated emails that may access admin APIs & pages
# (merged with OWNER_EMAILS for access). Google sign-in or /admin/login credentials.
ADMIN_EMAILS=jinank.thakker@gmail.com

# Optional: password login at /admin/login (set password to enable; do not use a weak password in production)
# ADMIN_CREDENTIALS_USER=admin
# ADMIN_CREDENTIALS_PASSWORD=admin123
# Session email shown for credential logins (defaults to jinank.thakker@gmail.com)
# ADMIN_SESSION_EMAIL=jinank.thakker@gmail.com